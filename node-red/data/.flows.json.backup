    {
        "id": "616f273da6342a5e",
        "type": "function",
        "z": "96b9cec355a795e1",
        "name": "Build Payload",
        "func": "msg.payload = {\n    action: \"CreateSubmissionRequest\",\n    appResource: \"/opt/spark/scripts/spark_kmeans_http.py\",\n    clientSparkVersion: \"4.1.2\",\n    mainClass: \"org.apache.spark.deploy.PythonRunner\",\n    appArgs: [\"/opt/spark/scripts/spark_kmeans_http.py\", \"\"],\n    environmentVariables: {},\n    sparkProperties: {\n        \"spark.master\": \"spark://spark-master:7077\",\n        \"spark.submit.deployMode\": \"client\",\n        \"spark.app.name\": \"KMeans_http\",\n        \"spark.driver.extraJavaOptions\": \"-Divy.cache.dir=/tmp/ivy -Divy.home=/tmp/ivy\",\n        \"spark.jars\": \"/opt/spark/external_jars/hadoop-aws-3.3.4.jar,/opt/spark/external_jars/aws-java-sdk-bundle-1.12.262.jar\"\n    }\n};\nreturn msg;",
