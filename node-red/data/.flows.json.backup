    {
        "id": "3d11d24e25edf062",
        "type": "function",
        "z": "4531295c81729e66",
        "name": "function 2",
        "func": "// Το msg.payload περιέχει ήδη όλο το καθαρό κείμενο JSON από τον προηγούμενο κόμβο\n\n// Ορίζουμε το όνομα που θέλουμε να πάρει το αρχείο ΜΕΣΑ στο MinIO\nmsg.filename = \"azure-cleaned-invocation.json\"; \n\n// Βάζουμε τα μεταδεδομένα που ζητάει ο καθηγητής\nmsg.headers = {\n    \"X-Amz-Meta-Source\": \"AzureFunctionsDataset2019\",\n    \"X-Amz-Meta-Status\": \"Unprocessed\", // Ο Spark θα ψάχνει αρχεία με status 'Unprocessed'\n    \"X-Amz-Meta-ProcessedBy\": \"Node-RED-Pipeline\"\n};\n\nreturn msg;",
        "outputs": 1,
