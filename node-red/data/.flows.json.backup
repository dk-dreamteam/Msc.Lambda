    {
        "id": "a73e0112de16f259",
        "type": "function",
        "z": "96b9cec355a795e1",
        "name": "storage prep",
        "func": "// 1. Set the target S3 object name using the property we passed along\nmsg.filename = msg.minioFilename;\n\n// 2. Add required metadata headers\nmsg.headers = {\n    \"X-Amz-Meta-Source\": \"AzureFunctionsDataset2019\",\n    \"X-Amz-Meta-Status\": \"Unprocessed\", \n    \"X-Amz-Meta-ProcessedBy\": \"Node-RED-Pipeline\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
