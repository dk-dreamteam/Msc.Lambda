    {
        "id": "ac8a9be8cb7bbf6f",
        "type": "function",
        "z": "96b9cec355a795e1",
        "name": "generate read list",
        "func": "// 1. Define all the trigger types we processed\nconst triggers = ['http', 'queue', 'orchestration', 'timer', 'storage'];\n\n// 2. Create a message for each file path\nconst fileMessages = triggers.map(type => {\n    return {\n        filename: `/data/datasets/cleaned_${type}_invocations.json`,\n        minioFilename: `azure-cleaned-${type}-invocation.json`\n    };\n});\n\n// 3. Output them sequentially to the next node\nreturn [fileMessages];",
        "outputs": 1,
