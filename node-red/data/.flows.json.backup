        "name": "prep delete files",
        "func": "// 1. List all 5 files that need a reset\nconst triggers = ['http', 'queue', 'orchestration', 'timer', 'storage'];\n\nconst deleteMessages = triggers.map(type => {\n    return {\n        filename: `/data/datasets/cleaned_${type}_invocations.json`\n    };\n});\n\n// 2. Output 5 individual messages to the delete node\nreturn [deleteMessages];",
