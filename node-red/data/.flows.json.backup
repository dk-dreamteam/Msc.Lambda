    {
        "id": "805442b89b275099",
        "type": "function",
        "z": "96b9cec355a795e1",
        "name": "filtering data",
        "func": "// 1. Check for end of file or empty payload\nif (!msg.payload || msg.payload === \"\" || (typeof msg.payload === 'object' && Object.keys(msg.payload).length === 0)) {\n    // Send FINISHED to Output 2\n    return [{ payload: \"FINISHED\" }, null];\n}\n\nconst row = msg.payload;\n\n// 2. Skip header row or invalid data\nif (!row.HashApp || row.HashApp === \"HashApp\") {\n    return null;\n}\n\n// 3. Sum daily invocations\nlet totalInvocations = 0;\nfor (let i = 1; i <= 1440; i++) {\n    const value = parseInt(row[i], 10);\n    if (!isNaN(value)) {\n        totalInvocations += value;\n    }\n}\n\n// 4. Filter and assign dynamic local path\nif (totalInvocations > 15) {\n    const validTriggers = ['http', 'queue', 'orchestration', 'timer', 'storage'];\n\n    if (validTriggers.includes(row.Trigger)) {\n        // Dynamically set local file path for the next node\n        msg.filename = `/data/datasets/cleaned_${row.Trigger}_invocations.json`;\n\n        msg.payload = {\n            HashApp: row.HashApp,\n            HashFunction: row.HashFunction,\n            Trigger: row.Trigger,\n            TotalDailyInvocations: totalInvocations\n        };\n\n        // Send data row to Output 1\n        return [null, msg];\n    }\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1050,
        "y": 540,
        "wires": [
