        "type": "function",
        "z": "4531295c81729e66",
        "name": "function 1",
        "func": "// 1. ΕΛΕΓΧΟΣ ΓΙΑ ΤΟ ΤΕΛΟΣ ΤΟΥ ΑΡΧΕΙΟΥ (Empty payload)\nif (!msg.payload || msg.payload === \"\" || (typeof msg.payload === 'object' && Object.keys(msg.payload).length === 0)) {\n    // Μόλις το αρχείο τελειώσει, στέλνουμε το σήμα FINISHED στην Έξοδο 2 (κάτω)\n    return [null, { payload: \"FINISHED\" }];\n}\n\nlet row = msg.payload;\n\n// Προστασία: Αν για κάποιο λόγο περάσει η επικεφαλίδα ως object, αγνόησέ τη\nif (row.HashApp === \"HashApp\" || !row.HashApp) {\n    return null;\n}\n\nlet totalInvocations = 0;\n\n// 2. ΑΘΡΟΙΣΜΑ: Αθροίζουμε τις κλήσεις από το λεπτό 1 έως το 1440\nfor (let i = 1; i <= 1440; i++) {\n    let value = parseInt(row[i.toString()]);\n    if (!isNaN(value)) {\n        totalInvocations += value;\n    }\n}\n\n// 3. ΚΡΙΤΗΡΙΟ ΦΙΛΤΡΑΡΙΣΜΑΤΟΣ: Κρατάμε όσα functions είχαν πάνω από 15 κλήσεις τη μέρα\nif (totalInvocations > 15) {\n    msg.payload = {\n        HashApp: row.HashApp,\n        HashFunction: row.HashFunction,\n        Trigger: row.Trigger,\n        TotalDailyInvocations: totalInvocations\n    };\n    \n    // Στέλνουμε το φιλτραρισμένο object στην Έξοδο 1 (πάνω) για το write file\n    return [msg, null];\n}\n\nreturn null;",
